{
  "name": "yap-impact-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^6.19.0",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-slot": "latest",
    "bcryptjs": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "framer-motion": "latest",
    "lucide-react": "latest",
    "mariadb": "^3.5.4",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "latest",
    "postcss": "^8.5.31",
    "prisma": "6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "latest",
    "typescript": "latest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "prisma@6.19.0": true,
    "@prisma/engines@6.19.0": true
  }
}
