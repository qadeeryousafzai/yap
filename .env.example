# MySQL database hosted by a managed provider (never localhost in production)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
AUTH_SECRET="generate-a-long-random-secret"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional integrations; the app degrades gracefully when not configured
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM="Youth Association of Pakistan <website@example.org>"
# Configure a Pakistan-eligible gateway (e.g. Safepay) only after account onboarding
PAYMENT_PROVIDER=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""
